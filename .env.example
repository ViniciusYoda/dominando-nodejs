NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_do_postgres
DB_NAME=dominando-nodejs
AUTH_SECRET=gere_um_segredo_aleatorio_longo
AUTH_EXPIRES_IN=7d

# Dados SMTP fornecidos pelo seu serviço de email.
MAIL_HOST=smtp.seu_provedor.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=seu_usuario_smtp
MAIL_PASS=sua_senha_smtp
MAIL_FROM_NAME=Dominando Node.js
MAIL_FROM_EMAIL=contato@seudominio.com

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
BULK_MAIL_CONCURRENCY=2
QUEUE_CONCURRENCY=2
QUEUE_RETRIES=3
QUEUE_BACKOFF_MS=1000
QUEUE_SHUTDOWN_TIMEOUT_MS=30000

# Sentry e logs (DSN obtido no projeto do Sentry).
LOG_LEVEL=info
SENTRY_ENABLED=false
SENTRY_DSN=
APP_RELEASE=dominando-nodejs@1.0.0
